---
import { TRUST_STRIP } from '@/data/delivery';

interface Props {
  locale: 'en' | 'ta';
  label?: string;
}

const { locale, label } = Astro.props;
const items = TRUST_STRIP[locale];
---

<section class="trust-strip" aria-label={label || (locale === 'en' ? 'Why families trust us' : 'ஏன் நம்புகிறார்கள்')}>
  <div class="container-custom py-5">
    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
      {items.map((item) => (
        <li class="text-center sm:text-left">
          <p class="font-semibold text-ink text-sm sm:text-base">{item.label}</p>
          <p class="text-ink-faint text-xs sm:text-sm mt-0.5">{item.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
