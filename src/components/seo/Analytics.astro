---
/**
 * Fires Plausible / gtag events on WhatsApp clicks when analytics IDs are present.
 * No-ops safely when PUBLIC_PLAUSIBLE_DOMAIN / PUBLIC_GA_ID are unset.
 */
import { SITE_CONFIG } from '@/utils/site-config';

const plausibleDomain = SITE_CONFIG.analytics.plausibleDomain || '';
const gaId = SITE_CONFIG.analytics.gaId || '';
---

{plausibleDomain && (
  <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
)}
{gaId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}

<script is:inline define:vars={{ plausibleDomain, gaId }}>
  (function () {
    function trackWhatsApp(context) {
      var props = { context: context || 'unknown' };
      try {
        if (plausibleDomain && typeof window.plausible === 'function') {
          window.plausible('WhatsApp Click', { props: props });
        }
      } catch (e) {}
      try {
        if (gaId && typeof window.gtag === 'function') {
          window.gtag('event', 'whatsapp_click', {
            event_category: 'engagement',
            event_label: props.context
          });
        }
      } catch (e) {}
    }

    function bind() {
      document.querySelectorAll('[data-wa-click]').forEach(function (el) {
        if (el.getAttribute('data-wa-bound') === '1') return;
        el.setAttribute('data-wa-bound', '1');
        el.addEventListener('click', function () {
          trackWhatsApp(el.getAttribute('data-wa-context') || el.getAttribute('data-wa-click') || 'whatsapp');
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bind);
    } else {
      bind();
    }
    document.addEventListener('astro:page-load', bind);
  })();
</script>
