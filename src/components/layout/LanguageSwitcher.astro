---
const locale = Astro.props.locale || 'en';
const currentLocale = locale;

const labels = {
  en: { switch: 'தமிழ்', current: 'English' },
  ta: { switch: 'English', current: 'தமிழ்' }
}[currentLocale] || { switch: 'தமிழ்', current: 'English' };
---

<div class="relative" id="language-switcher">
  <button
    type="button"
    class="flex items-center gap-2 px-3 py-2 rounded-md bg-leaf-50 text-ink-muted hover:bg-leaf-100 hover:text-leaf-800 transition-colors font-medium text-sm border border-leaf-100"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={currentLocale === 'en' ? 'Switch to Tamil' : 'Switch to English'}
    id="lang-toggle"
  >
    <span class="hidden sm:inline">{labels.current}</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <ul
    class="absolute right-0 mt-1 w-36 bg-paper-soft rounded-md shadow-lift border border-leaf-100 py-1 opacity-0 invisible translate-y-1 transition-all duration-200 z-50"
    role="listbox"
    aria-labelledby="lang-toggle"
    id="lang-menu"
  >
    <li role="option" aria-selected={currentLocale === 'en'} class={currentLocale === 'en' ? 'bg-leaf-50' : ''}>
      <a href={`/en${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`} class="flex items-center gap-2 px-3 py-2 text-sm text-ink hover:bg-leaf-50" hreflang="en">
        <span class="font-medium">English</span>
      </a>
    </li>
    <li role="option" aria-selected={currentLocale === 'ta'} class={currentLocale === 'ta' ? 'bg-leaf-50' : ''}>
      <a href={`/ta${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`} class="flex items-center gap-2 px-3 py-2 text-sm text-ink hover:bg-leaf-50" hreflang="ta">
        <span class="font-medium">தமிழ்</span>
      </a>
    </li>
  </ul>
</div>

<script is:inline>
  (() => {
    const toggle = document.getElementById('lang-toggle');
    const menu = document.getElementById('lang-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', (!expanded).toString());
        menu.classList.toggle('opacity-0');
        menu.classList.toggle('invisible');
        menu.classList.toggle('translate-y-1');
        menu.classList.toggle('translate-y-0');
      });
      document.addEventListener('click', (e) => {
        if (!toggle.contains(e.target) && !menu.contains(e.target)) {
          toggle.setAttribute('aria-expanded', 'false');
          menu.classList.add('opacity-0', 'invisible', 'translate-y-1');
          menu.classList.remove('translate-y-0');
        }
      });
    }
  })();
</script>
