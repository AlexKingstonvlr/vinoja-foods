---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { formatDate } from '@/utils/helpers';
import { getBlogPosts } from '@/data/blog';

const locale = 'ta';
const posts = getBlogPosts(locale);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'கதைகள் — வினோஜா ஃபூட்ஸ்',
  description: 'தமிழ்நாட்டுச் சிறப்புகள், பண்டிகைகள், தோற்றம் ஏன் முக்கியம் — வினோஜா ஃபூட்ஸ் கதைகள்.',
  url: 'https://vinojafoods.com/ta/blog'
};
---

<BaseLayout
  title="கதைகள் — வினோஜா ஃபூட்ஸ் | தமிழ்நாட்டு தின்பண்டங்கள்"
  description="பிராந்திய முறுக்கு, பண்டிகை இனிப்புகள், டீ-நேரம் — சிறப்புகள் ஒரு நாளுக்குள் சென்னை கடைக்கு எப்படி வருகின்றன."
  locale={locale}
>
  <StructuredData locale={locale} data={structuredData} />
  <Header locale={locale} />

  <main id="main-content">
    <PageHero
      locale={locale}
      label="வாழை இலையிலிருந்து"
      title="கதைகள்"
      subtitle="மரபு, பண்டிகைகள், தயாரிக்கும் ஊர் ஏன் சுவையை மாற்றுகிறது — உண்மையான தமிழ்நாட்டு தின்பண்டங்களை விரும்பும் குடும்பங்களுக்காக."
      breadcrumbs={[
        { name: 'முகப்பு', url: '/ta/' },
        { name: 'கதைகள்', url: '/ta/blog/' }
      ]}
    />

    <section class="section">
      <div class="container-custom">
        {posts.length === 0 ? (
          <p class="text-body text-center py-16">கதைகள் விரைவில். இதற்கிடையில் இன்றைய சிறப்புகளுக்கு வாட்ஸ்அப்பில் செய்தி அனுப்புங்கள்.</p>
        ) : (
          <div class="grid gap-8 sm:grid-cols-2">
            {posts.map((post, i) => (
              <a
                href={`/ta/blog/${post.slug}/`}
                class="group block bg-paper-soft/90 rounded-xl overflow-hidden border border-leaf-100/80 transition-all duration-300 hover:shadow-lift hover:border-leaf-200 hover:-translate-y-1 animate-in"
                style={`animation-delay: ${i * 80}ms`}
              >
                <div class="relative overflow-hidden aspect-[16/10]">
                  <img
                    src={post.image}
                    alt=""
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-transparent"></div>
                </div>
                <div class="p-6">
                  <div class="flex flex-wrap items-center gap-2 text-sm text-ink-faint">
                    <time datetime={post.date}>{formatDate(post.date, 'ta')}</time>
                    <span aria-hidden="true">·</span>
                    <span>{post.author}</span>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {post.tags.slice(0, 3).map((tag) => (
                      <span class="badge badge-primary">{tag}</span>
                    ))}
                  </div>
                  <h2 class="heading-3 mt-4 group-hover:text-leaf-700 transition-colors text-balance">
                    {post.title}
                  </h2>
                  <p class="mt-3 text-ink-muted line-clamp-3 leading-relaxed">{post.excerpt}</p>
                  <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-leaf-700">
                    கதையைப் படியுங்கள்
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <CtaBand
      locale={locale}
      title="கதையில் வந்த சுவை வேண்டுமா?"
      subtitle="தின்பண்டத்தைச் சொல்லுங்கள் — சென்னை கடையில் புதிய பிராந்தியப் பொட்டலத்தை உறுதி செய்கிறோம்."
      buttonText="வாட்ஸ்அப்பில் ஆர்டர்"
      message="வணக்கம் வினோஜா ஃபூட்ஸ்! உங்கள் கதைகளைப் படித்தேன்; ஆர்டர் செய்ய விரும்புகிறேன்."
    />
  </main>

  <Footer locale={locale} />
  <WhatsAppButton locale={locale} variant="floating" />
</BaseLayout>
