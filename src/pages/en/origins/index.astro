---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import PageHero from '@/components/ui/PageHero.astro';
import OriginsSection from '@/components/ui/OriginsSection.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { ORIGIN_REGIONS, ORIGINS_PAGE } from '@/data/origins';
import { getProductBySlug } from '@/data/products';

const locale = 'en';
const page = ORIGINS_PAGE.en;

const regionCards = ORIGIN_REGIONS.map((r) => ({
  place: r.place.en,
  specialty: r.specialty.en,
  products: r.productSlugs
    .map((s) => getProductBySlug(s))
    .filter((p) => Boolean(p))
    .map((p) => ({ slug: p!.slug, name: p!.name }))
}));
---

<BaseLayout
  locale={locale}
  title="Tamil Nadu Origins — Best of Every Region | Vinoja Foods"
  description="Snacks and sweets made in the towns famous for them across Tamil Nadu — hygienically packed, sold fresh at our Chennai shop within a day."
>
  <StructuredData locale={locale} />
  <Header locale={locale} />

  <main id="main-content" role="main">
    <PageHero
      locale={locale}
      label={page.label}
      title={page.title}
      subtitle={page.subtitle}
      breadcrumbs={[
        { name: 'Home', url: '/en/' },
        { name: 'Origins', url: '/en/origins/' }
      ]}
    />

    <OriginsSection locale={locale} showLink={false} />

    <section class="section bg-paper-soft border-y border-leaf-100" aria-labelledby="origin-list">
      <div class="container-custom">
        <h2 id="origin-list" class="heading-3 mb-8">District → specialty</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {regionCards.map((r) => (
            <div class="rounded-xl border border-leaf-100 bg-white/70 p-5">
              <h3 class="font-display font-semibold text-ink text-lg">{r.place}</h3>
              <p class="text-sm text-ink-muted mt-1 mb-3">{r.specialty}</p>
              <ul class="flex flex-wrap gap-2">
                {r.products.map((p) => (
                  <li>
                    <a href={`/en/products/${p.slug}/`} class="text-sm font-medium text-leaf-700 hover:underline">
                      {p.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      locale={locale}
      title="Taste a region this week"
      subtitle="Tell us what you’re craving — we’ll confirm what’s fresh at the Chennai shop."
      buttonText="Order on WhatsApp"
      message="Hello Vinoja Foods! I'd like to order regional specialties from Tamil Nadu."
    />
  </main>

  <Footer locale={locale} />
  <WhatsAppButton
    locale={locale}
    variant="floating"
    text="Order"
    message="Hello Vinoja Foods! I'd like to order regional specialties."
  />
</BaseLayout>
