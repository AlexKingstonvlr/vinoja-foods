# Vinoja Foods - Environment Variables
# Copy to .env and fill in your values
#
# OWNER TODO (Alex): replace placeholders before go-live
# - PUBLIC_WHATSAPP_NUMBER — real business WhatsApp (country code, no +)
# - PUBLIC_CONTACT_PHONE / PUBLIC_ADDRESS_* — real shop contact & address
# - PUBLIC_MAP_LAT / PUBLIC_MAP_LNG — exact shop coordinates for map + LocalBusiness schema
# - PUBLIC_PLAUSIBLE_DOMAIN and/or PUBLIC_GA_ID — analytics (optional; WhatsApp clicks no-op if unset)
# - Real Google reviews / customer photos — do not invent; wire when available
# - Google Business Profile (GBP) link — add to sameAs / contact when ready

# Site
PUBLIC_SITE_URL=https://vinojafoods.com
PUBLIC_SITE_NAME_EN="Vinoja Foods"
PUBLIC_SITE_NAME_TA="வினோஜா ஃபூட்ஸ்"
PUBLIC_DEFAULT_LOCALE=en

# WhatsApp (required for ordering — use real number without +)
PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
PUBLIC_WHATSAPP_DEFAULT_MESSAGE_EN="Hello Vinoja Foods, I'd like to place an order."
PUBLIC_WHATSAPP_DEFAULT_MESSAGE_TA="வணக்கம் வினோஜா ஃபூட்ஸ், நான் ஆர்டர் வேண்டும்."

# Contact (placeholders until shop details confirmed)
PUBLIC_CONTACT_EMAIL=info@vinojafoods.com
PUBLIC_CONTACT_PHONE=+91 XXXXXXXXXX
PUBLIC_ADDRESS_EN="123 Main Street, Chennai, Tamil Nadu 600001, India"
PUBLIC_ADDRESS_TA="123 மேன் ஸ்ட்ரீட், சென்னை, தமிழ்நாடு 600001, இந்தியா"

# Map (Chennai shop) — OpenStreetMap embed; no API key required
PUBLIC_MAP_LAT=13.0827
PUBLIC_MAP_LNG=80.2707
PUBLIC_MAP_ZOOM=15

# Social
PUBLIC_INSTAGRAM_URL=https://instagram.com/vinojafoods
PUBLIC_FACEBOOK_URL=https://facebook.com/vinojafoods
PUBLIC_YOUTUBE_URL=https://youtube.com/@vinojafoods
PUBLIC_TWITTER_URL=https://twitter.com/vinojafoods

# Analytics (optional — WhatsApp click events fire only when set)
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_GA_ID=

# CMS (Decap CMS - GitHub backend)
DECAP_CMS_GITHUB_REPO=yourusername/vinoja-foods
DECAP_CMS_GITHUB_BRANCH=main

# Forms (Netlify Forms / Formspree)
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
